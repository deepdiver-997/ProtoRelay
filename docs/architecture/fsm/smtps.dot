digraph fsm {
  rankdir=LR;
  node [shape=box fontname="monospace"];
  "INIT";
  "GREETING";
  "WAIT_EHLO";
  "WAIT_AUTH";
  "WAIT_AUTH_USERNAME";
  "WAIT_AUTH_PASSWORD";
  "WAIT_MAIL_FROM";
  "WAIT_RCPT_TO";
  "WAIT_DATA";
  "IN_MESSAGE";
  "WAIT_QUIT";
  "CLOSED" [peripheries=2];
  "INIT" -> "GREETING" [label="CONNECT"];
  "GREETING" -> "WAIT_EHLO" [label="CONNECT"];
  "WAIT_EHLO" -> "WAIT_AUTH" [label="EHLO {EHLO/HELO}"];
  "GREETING" -> "WAIT_AUTH" [label="EHLO {EHLO/HELO}"];
  "WAIT_AUTH" -> "WAIT_AUTH" [label="EHLO {EHLO/HELO}"];
  "WAIT_AUTH" -> "WAIT_AUTH_USERNAME" [label="AUTH {AUTH}"];
  "WAIT_AUTH" -> "WAIT_MAIL_FROM" [label="AUTH {AUTH}"];
  "WAIT_AUTH" -> "WAIT_AUTH" [label="AUTH {AUTH}"];
  "WAIT_AUTH_USERNAME" -> "WAIT_AUTH_PASSWORD" [label="AUTH {AUTH}"];
  "WAIT_AUTH_USERNAME" -> "WAIT_AUTH" [label="AUTH {AUTH}"];
  "WAIT_AUTH_PASSWORD" -> "WAIT_MAIL_FROM" [label="AUTH {AUTH}"];
  "WAIT_AUTH_PASSWORD" -> "WAIT_AUTH" [label="AUTH {AUTH}"];
  "WAIT_AUTH" -> "WAIT_RCPT_TO" [label="MAIL_FROM {MAIL FROM}"];
  "WAIT_MAIL_FROM" -> "WAIT_RCPT_TO" [label="MAIL_FROM {MAIL FROM}"];
  "WAIT_RCPT_TO" -> "WAIT_RCPT_TO" [label="MAIL_FROM {MAIL FROM}"];
  "WAIT_MAIL_FROM" -> "WAIT_AUTH" [label="MAIL_FROM {MAIL FROM}"];
  "WAIT_RCPT_TO" -> "WAIT_AUTH" [label="MAIL_FROM {MAIL FROM}"];
  "WAIT_RCPT_TO" -> "WAIT_RCPT_TO" [label="RCPT_TO {RCPT TO}"];
  "WAIT_RCPT_TO" -> "IN_MESSAGE" [label="DATA {DATA}"];
  "WAIT_DATA" -> "IN_MESSAGE" [label="DATA {DATA}"];
  "IN_MESSAGE" -> "IN_MESSAGE" [label="DATA {DATA}"];
  "IN_MESSAGE" -> "WAIT_MAIL_FROM" [label="DATA_END"];
  "IN_MESSAGE" -> "WAIT_QUIT" [label="DATA_END"];
  "WAIT_QUIT" -> "WAIT_RCPT_TO" [label="MAIL_FROM {MAIL FROM}"];
  "WAIT_AUTH" -> "INIT" [label="STARTTLS {STARTTLS}"];
  "INIT" -> "CLOSED" [label="QUIT {QUIT}"];
  "INIT" -> "INIT" [label="ERROR"];
  "INIT" -> "INIT" [label="TIMEOUT"];
  "INIT" -> "INIT" [label="EMPTY"];
  "GREETING" -> "CLOSED" [label="QUIT {QUIT}"];
  "GREETING" -> "GREETING" [label="ERROR"];
  "GREETING" -> "GREETING" [label="TIMEOUT"];
  "GREETING" -> "GREETING" [label="EMPTY"];
  "WAIT_EHLO" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_EHLO" -> "WAIT_EHLO" [label="ERROR"];
  "WAIT_EHLO" -> "WAIT_EHLO" [label="TIMEOUT"];
  "WAIT_EHLO" -> "WAIT_EHLO" [label="EMPTY"];
  "WAIT_AUTH" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_AUTH" -> "WAIT_AUTH" [label="ERROR"];
  "WAIT_AUTH" -> "WAIT_AUTH" [label="TIMEOUT"];
  "WAIT_AUTH" -> "WAIT_AUTH" [label="EMPTY"];
  "WAIT_AUTH_USERNAME" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_AUTH_USERNAME" -> "WAIT_AUTH_USERNAME" [label="ERROR"];
  "WAIT_AUTH_USERNAME" -> "WAIT_AUTH_USERNAME" [label="TIMEOUT"];
  "WAIT_AUTH_USERNAME" -> "WAIT_AUTH_USERNAME" [label="EMPTY"];
  "WAIT_AUTH_PASSWORD" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_AUTH_PASSWORD" -> "WAIT_AUTH_PASSWORD" [label="ERROR"];
  "WAIT_AUTH_PASSWORD" -> "WAIT_AUTH_PASSWORD" [label="TIMEOUT"];
  "WAIT_AUTH_PASSWORD" -> "WAIT_AUTH_PASSWORD" [label="EMPTY"];
  "WAIT_MAIL_FROM" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_MAIL_FROM" -> "WAIT_MAIL_FROM" [label="ERROR"];
  "WAIT_MAIL_FROM" -> "WAIT_MAIL_FROM" [label="TIMEOUT"];
  "WAIT_MAIL_FROM" -> "WAIT_MAIL_FROM" [label="EMPTY"];
  "WAIT_RCPT_TO" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_RCPT_TO" -> "WAIT_RCPT_TO" [label="ERROR"];
  "WAIT_RCPT_TO" -> "WAIT_RCPT_TO" [label="TIMEOUT"];
  "WAIT_RCPT_TO" -> "WAIT_RCPT_TO" [label="EMPTY"];
  "WAIT_DATA" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_DATA" -> "WAIT_DATA" [label="ERROR"];
  "WAIT_DATA" -> "WAIT_DATA" [label="TIMEOUT"];
  "WAIT_DATA" -> "WAIT_DATA" [label="EMPTY"];
  "IN_MESSAGE" -> "CLOSED" [label="QUIT {QUIT}"];
  "IN_MESSAGE" -> "IN_MESSAGE" [label="ERROR"];
  "IN_MESSAGE" -> "IN_MESSAGE" [label="TIMEOUT"];
  "IN_MESSAGE" -> "IN_MESSAGE" [label="EMPTY"];
  "WAIT_QUIT" -> "CLOSED" [label="QUIT {QUIT}"];
  "WAIT_QUIT" -> "WAIT_QUIT" [label="ERROR"];
  "WAIT_QUIT" -> "WAIT_QUIT" [label="TIMEOUT"];
  "WAIT_QUIT" -> "WAIT_QUIT" [label="EMPTY"];
}
