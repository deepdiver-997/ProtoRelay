digraph fsm {
  rankdir=LR;
  node [shape=box fontname="monospace"];
  "INIT";
  "NOT_AUTHENTICATED";
  "AUTHENTICATED";
  "SELECTED";
  "LOGOUT" [peripheries=2];
  "CLOSED" [peripheries=2];
  "INIT" -> "NOT_AUTHENTICATED" [label="CONNECT"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="CAPABILITY {CAPABILITY}"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="LOGIN {LOGIN}"];
  "NOT_AUTHENTICATED" -> "AUTHENTICATED" [label="LOGIN {LOGIN}"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="AUTHENTICATE {AUTHENTICATE}"];
  "NOT_AUTHENTICATED" -> "AUTHENTICATED" [label="AUTHENTICATE {AUTHENTICATE}"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="NOOP {NOOP}"];
  "NOT_AUTHENTICATED" -> "LOGOUT" [label="LOGOUT {LOGOUT}"];
  "AUTHENTICATED" -> "SELECTED" [label="SELECT {SELECT}"];
  "AUTHENTICATED" -> "SELECTED" [label="EXAMINE {EXAMINE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="CAPABILITY {CAPABILITY}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="LIST {LIST}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="LSUB {LSUB}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="STATUS {STATUS}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="CREATE {CREATE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="DELETE {DELETE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="RENAME {RENAME}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="SUBSCRIBE {SUBSCRIBE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="UNSUBSCRIBE {UNSUBSCRIBE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="APPEND {APPEND}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="CHECK {CHECK}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="CLOSE {CLOSE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="NOOP {NOOP}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="IDLE {IDLE}"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="DONE {DONE}"];
  "AUTHENTICATED" -> "LOGOUT" [label="LOGOUT {LOGOUT}"];
  "SELECTED" -> "SELECTED" [label="FETCH {FETCH}"];
  "SELECTED" -> "SELECTED" [label="STORE {STORE}"];
  "SELECTED" -> "SELECTED" [label="SEARCH {SEARCH}"];
  "SELECTED" -> "SELECTED" [label="COPY {COPY}"];
  "SELECTED" -> "SELECTED" [label="MOVE {MOVE}"];
  "SELECTED" -> "SELECTED" [label="UID {UID}"];
  "SELECTED" -> "SELECTED" [label="EXPUNGE {EXPUNGE}"];
  "SELECTED" -> "SELECTED" [label="SELECT {SELECT}"];
  "SELECTED" -> "SELECTED" [label="EXAMINE {EXAMINE}"];
  "SELECTED" -> "AUTHENTICATED" [label="CLOSE {CLOSE}"];
  "SELECTED" -> "SELECTED" [label="CHECK {CHECK}"];
  "SELECTED" -> "SELECTED" [label="CAPABILITY {CAPABILITY}"];
  "SELECTED" -> "SELECTED" [label="STATUS {STATUS}"];
  "SELECTED" -> "SELECTED" [label="NOOP {NOOP}"];
  "SELECTED" -> "SELECTED" [label="APPEND {APPEND}"];
  "SELECTED" -> "SELECTED" [label="IDLE {IDLE}"];
  "SELECTED" -> "SELECTED" [label="DONE {DONE}"];
  "SELECTED" -> "LOGOUT" [label="LOGOUT {LOGOUT}"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="STARTTLS {STARTTLS}"];
  "INIT" -> "INIT" [label="ERROR"];
  "INIT" -> "INIT" [label="TIMEOUT"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="ERROR"];
  "NOT_AUTHENTICATED" -> "NOT_AUTHENTICATED" [label="TIMEOUT"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="ERROR"];
  "AUTHENTICATED" -> "AUTHENTICATED" [label="TIMEOUT"];
  "SELECTED" -> "SELECTED" [label="ERROR"];
  "SELECTED" -> "SELECTED" [label="TIMEOUT"];
}
