# tools/agents/agents.conf —— 本机参数。拷一份：cp agents.conf.example agents.conf（agents.conf 已 gitignore）
# 全部可省略，省略即默认值。被 lib.sh 以 bash 语法 source，只写 KEY=VALUE。

# worktree 存放位置：固定在 ~/.agent-workspaces/workspaces/<项目名>/，与磁盘账本同家，
# 全机器一份，不提供选项更改。项目命名空间自动取 hub 父目录名。
# （新机器要调的参数见 ~/.agent-parallel/README.md 的「新机器初始化」）

# 新 worktree 的基准分支
#BASE_BRANCH=main

# build.sh 等全局构建锁的最长秒数（hub + 所有 worktree 同时只跑一个构建）
#BUILD_LOCK_WAIT=3600

# 装了 ccache 就自动启用；0 关闭
#USE_CCACHE=auto

# 端口分配：agent N 默认拿 [START + N*SIZE, +SIZE) 这一段；被占则整段后移
#PORT_BLOCK_START=20000
#PORT_BLOCK_SIZE=100

# 临时目录 / 数据库名前缀（后接 AGENT_INDEX）
#TMP_ROOT_PREFIX=/tmp/protorelay_agent_
#DB_NAME_PREFIX=mail_agent_

# 开一个新 worktree 时在设备磁盘账本里登记的预估值（GB）；构建后按实际 du 修正。
# 需要 Debug 级构建的 worktree 记得调大（本项目 Debug 构建目录实测 ~16G）。
#DISK_RESERVE_GB=5
