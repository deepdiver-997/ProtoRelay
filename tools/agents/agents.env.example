# tools/agents/agents.env —— agent 并行工具的本机/本项目参数（KEY=VALUE，bash 直接 source）
#
# 两层放置，项目内覆盖机器级：
#   机器级  ~/.agent-parallel/tools/agents.env    一台机器一份（锁等待 / ccache / 端口段起点等）
#   项目级  <项目>/tools/agents/agents.env        本项目覆盖（基准分支 / 资源命名 / 预算预估等）
# 本文件是模板：cp agents.env.example agents.env 后按需去掉行首 # 填写；agents.env 被 gitignore。
# 工作区根目录不在参数里：固定 ~/.agent-workspaces/workspaces/<项目名>/（一台机器一处，无旋钮）。

# ---------- 通常放机器级（全局母本那份） ----------
# build.sh 等全局构建锁的最长秒数
#BUILD_LOCK_WAIT=3600
# 装了 ccache 就自动启用；0 关闭
#USE_CCACHE=auto
# 端口段分配：agent N 默认拿 [START + N*SIZE, +SIZE)；被占则整段后移。
# 这是机器级参数——多项目共用一台机器时全局保持一致，避免各项目从同一起点抢段。
#PORT_BLOCK_START=20000
#PORT_BLOCK_SIZE=100

# ---------- 通常放项目级（本项目这份） ----------
# 新 worktree 的基准分支
#BASE_BRANCH=main
# 开一个新 worktree 时在设备磁盘账本里登记的预估值（GB）；构建后按实际 du 修正。
# 需要 Debug 级构建的 worktree 记得调大（本项目 Debug 构建目录实测 ~16G）。
#DISK_RESERVE_GB=5
# 临时目录 / 数据库名前缀（后接 AGENT_INDEX）
#TMP_ROOT_PREFIX=/tmp/protorelay_agent_
#DB_NAME_PREFIX=mail_agent_
# 无头派发（spawn.sh）完成标准里的构建/测试命令，按项目改写
#BUILD_CMD=./build.sh Release
#TEST_CMD=bash test/run_all_tests.sh --no-build
